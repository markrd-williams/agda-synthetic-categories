open import Core.SigmaIdentityProperties
open import Core.Joins

open import Synthetic.CoStrict Δ¹ I
}
}

\agda{
Lᵒ : ∀ {𝓤} (X : Type 𝓤) → Type (𝓘 ⊔ 𝓤)
Lᵒ X = Σ[ i ∶ Δ¹ ] ((i ＝ i1) → X)

Lᵒ₁ : ∀ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} (f : X → Y)
    → Lᵒ X → Lᵒ Y
Lᵒ₁ f (i , p) = i , (f ∘ p)

Scn : ∀ {𝓤} (X : Type 𝓤) → Type (𝓘 ⊔ 𝓤)
Scn X = Σ[ i ∶ Δ¹ ] ((i ＝ i0) * X)

Scn₁
  : ∀ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} (f : X → Y)
    → Scn X → Scn Y
Scn₁ f (i , x) = (i , (id *₁ f) x)
}

\agda{
module WithCoStrict {𝓤} {X : Type 𝓤} (X-is-co-strict : is-co-strict X) where

  is-single←i=1←i=0 : {i : Δ¹} → (i ＝ i0) → (i ＝ i1) → is-singleton X
  is-single←i=1←i=0 p q
    = is-single-if-0=1←is-co-strict X-is-co-strict (sym p ∙ q)

  σ-part-cocone
    : (i : Δ¹)
    → Cocone (*-span (i ＝ i0) X) (i ＝ i1 → X)
  σ-part-cocone i .Cocone.p p q
    = is-single←i=1←i=0 p q .centre
  σ-part-cocone i .Cocone.q x _ = x
  σ-part-cocone i .Cocone.filler (p , x)
    = funext→ (λ q → is-single←i=1←i=0 p q .central x)

  σ-part : (i : Δ¹) → (i ＝ i0) * X → (i ＝ i1) → X
  σ-part i = pushout-rec (σ-part-cocone i)

  τ-part-cocone
    : (i : Δ¹)
    → Cocone (*-span X (i ＝ i1)) (i ＝ i0 → X)
  τ-part-cocone i .Cocone.p x _
    = x
  τ-part-cocone i .Cocone.q p q
    = is-single-if-0=1←is-co-strict X-is-co-strict (sym q ∙ p) .centre
  τ-part-cocone i .Cocone.filler (x , p)
    = funext→ (λ q → sym
      (is-single-if-0=1←is-co-strict X-is-co-strict (sym q ∙ p) .central x))

  τ-part : (i : Δ¹) → X * (i ＝ i1) → (i ＝ i0) → X
  τ-part = pushout-rec ∘ τ-part-cocone

  σ : Scn X → Lᵒ X
  σ = total-map σ-part

  σ-part-nat
    : {i j : Δ¹}
    → (f : (j ＝ i1) → (i ＝ i1))
    → (g : (i ＝ i0) → (j ＝ i0))
    → (a : (i ＝ i0) * X)
    → ((_∘ f) ∘ σ-part i) a ~ (σ-part j ∘ (g *₁ id)) a
  σ-part-nat {i} {j} f g a q
    = pushout-ind
        (λ z → ((_∘ f) ∘ σ-part i) z q ＝ (σ-part j ∘ (g *₁ id)) z q)
        (mk-coconeᵈ
          (λ p → is-prop←is-single (is-single←i=1←i=0 p (f q)) _ _)
          (~refl)
          (λ (p , _) → is-truncated←is-single
            (is-single←i=1←i=0 p (f q)) {n = 0𝕋} _ _ _ _))
        (a)

module _
  {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥}
  (X-is-co-strict : is-co-strict X)
  (Y-is-co-strict : is-co-strict Y)
  (let module X = WithCoStrict X-is-co-strict)
  (let module Y = WithCoStrict Y-is-co-strict)
  where

  σ-part-nat'
    : {j : Δ¹} (f : X → Y) (a : (j ＝ i0) * X)
    → f ∘ X.σ-part j a ~ Y.σ-part j ((id *₁ f) a)
  σ-part-nat' f
    = pushout-ind _
        (mk-coconeᵈ
          (λ p q → is-prop←is-single (Y.is-single←i=1←i=0 p q) _ _)
          (λ _ → ~refl)
          (λ (p , _) → funext→ (λ q → is-truncated←is-single
            (Y.is-single←i=1←i=0 p q) {n = 0𝕋} _ _ _ _)))

  Sierpinski-interchange-ι₁
    : (i : Δ¹) (p : i ＝ i0) (y : Y * (i ＝ i1))
    → (id *₁ X.σ-part i (ι₁ p)) y ＝ ι₁ (Y.τ-part i y p)
  Sierpinski-interchange-ι₁ i p
    = pushout-ind _
        (mk-coconeᵈ
          (~refl)
          (λ q → sym (glue (_ , _)))
          ( λ (_ , q) → is-truncated←is-single
              (*-single' (X.is-single←i=1←i=0 p q)) {n = 0𝕋} _ _ _ _))

  Sierpinski-interchange
    : (i : Δ¹)
    → (x : (i ＝ i0) * X) (y : Y * (i ＝ i1))
    → (id *₁ (X.σ-part i x)) y ＝ (Y.τ-part i y *₁ id) x
  Sierpinski-interchange i x y
    = cogap-unique
        (X.σ-part-cocone i) (λ f → (id *₁ f) y) _
        (λ p → Sierpinski-interchange-ι₁ i p y)
        (λ x → *₁-const-right id x y)
        (λ (p , x) → pushout-ind
          ( λ y
            → ap (λ f → (id *₁ f) y) (X.σ-part-cocone i .Cocone.filler (p , x))
            ∙ *₁-const-right id x y
            ＝ Sierpinski-interchange-ι₁ i p y ∙ glue (Y.τ-part i y p , x))
          (mk-coconeᵈ
            (λ y → ap (_∙ glue (y , x)) (ap-const _))
            ( λ q → is-truncated←is-single
                (*-single' (X.is-single←i=1←i=0 p q)) {n = 0𝕋} _ _ _ _)
            ( λ (_ , q) → is-truncated←is-single
                (*-single' (X.is-single←i=1←i=0 p q)) {n = 1𝕋} _ _ _ _ _ _))
          (y))
        (x)

}

\agda{
opaque
  χ : {i j : Δ¹} → j ＝ i0 → i ∧ j ＝ i0
  χ refl = ∧-bot-right 0-bottom

  ψ : {i j : Δ¹} → i ＝ i0 → i ∧ j ＝ i0
  ψ refl = ∧-bot-left 0-bottom

  ϕ' : {i j : Δ¹} → i ∧ j ＝ i1 → j ＝ i1
  ϕ' p = ≤-antisym (1-top _) (≤-trans (≥←＝ p) ∧-≤-right)

  ϕ : {i j : Δ¹} → i ∧ j ＝ i1 → i ＝ i1
  ϕ p = ≤-antisym (1-top _) (≤-trans (≥←＝ p) ∧-≤-left)

module _ {𝓤} {X : Type 𝓤} where

  ε̄ : (i : Δ¹) → ((i ＝ i1) → X) × Scn (i ＝ i1) → Scn X
  ε̄ i (x , j , p) .fst = i ∧ j
  ε̄ i (x , j , p) .snd = (χ *₁ x) p

  ε̃ : (i : Δ¹) → ((i ＝ i0) * X) × Lᵒ (i ＝ i1) → Scn X
  ε̃ i (x , j , p) .fst = i ∧ j
  ε̃ i (x , j , p) .snd = (ψ *₁ id) x

  ε : (i : Δ¹) → (i ＝ i1 → X) × Lᵒ (i ＝ i1) → Lᵒ X
  ε i (x , j , p) .fst = i ∧ j
  ε i (x , j , p) .snd = x ∘ ϕ

module WithCoStrictMeet
  {𝓤} {X : Type 𝓤} (X-is-co-strict : is-co-strict X)
  (let module X = WithCoStrict X-is-co-strict)
  (let module D {i j : Δ¹} = WithCoStrict (Δ¹-＝-is-co-strict {i} {j}))
  where

  H-path
    : (i : Δ¹) (x : (i ＝ i0) * X) (j : Δ¹) (p : (j ＝ i0) * (i ＝ i1))
    → (χ *₁ X.σ-part i x) p ＝ (ψ *₁ id) x
  H-path i x j p
    = (χ *₁ X.σ-part i x) p
        ＝⟨ sym (*₁-∘ _ _ _ _ p) ⟩
      ((χ *₁ id) ∘ (id *₁ X.σ-part i x)) p
        ＝⟨ ap
            (χ *₁ id)
            (Sierpinski-interchange X-is-co-strict Δ¹-＝-is-co-strict i x p) ⟩
      ((χ *₁ id) ∘ (D.τ-part i p) *₁ id) x
        ＝⟨ *₁-∘ _ _ _ _ x ⟩
      ((χ ∘ (D.τ-part i p)) *₁ id) x
        ＝⟨⟩
      *₁-htpy (λ _ → prop!) ~refl x

  H : (i : Δ¹) → ε̄ {X = X} i ∘ (X.σ-part i ×₁ id) ~ ε̃ i ∘ id ×₁ D.σ
  H i (x , (j , p)) = Σ-path→ (refl , H-path i x j p)

  ε̄̃-Cocone
    : (i : Δ¹)
    → Cocone (mk-span _ (X.σ-part i ×₁ id) (id ×₁ D.σ)) (Scn X)
  ε̄̃-Cocone i .Cocone.p = ε̄ i
  ε̄̃-Cocone i .Cocone.q = ε̃ i
  ε̄̃-Cocone i .Cocone.filler = H i

  ε̄̃ : (i : Δ¹)
    → Pushout (X.σ-part i ×₁ id) (id ×₁ D.σ)
    → Scn X
  ε̄̃ = pushout-rec ∘ ε̄̃-Cocone

  f-htpy
    : (i : Δ¹) (x : i ＝ i1 → X) (j : Δ¹) (p : (j ＝ i0) * (i ＝ i1))
    → x ∘ ϕ ~ X.σ-part (i ∧ j) ((χ *₁ x) p)
  f-htpy i x j p
    = x ∘ ϕ
        ~⟨ x ◃h (λ a → prop!) ⟩
      x ∘ D.σ-part (i ∧ j) ((χ *₁ id) p)
        ~⟨ σ-part-nat' Δ¹-＝-is-co-strict X-is-co-strict x ((χ *₁ id) p) ⟩
      (X.σ-part (i ∧ j) ∘ (id *₁ x) ∘ (χ *₁ id)) p
        ~⟨⟩
      happly ((X.σ-part (i ∧ j) ◃h (*₁-∘ id x χ id)) p)

  f-path
    : (i : Δ¹) (x : i ＝ i1 → X) (j : Δ¹) (p : (j ＝ i0) * (i ＝ i1))
    → x ∘ ϕ ＝ X.σ-part (i ∧ j) ((χ *₁ x) p)
  f-path i x j = funext→ ∘ f-htpy i x j

  S : (i : Δ¹) → Arrow-map (pushout-product (X.σ-part i) D.σ) X.σ
  S i .Arrow-Π.top = ε̄̃ i
  S i .Arrow-Π.bot = ε i
  S i .Arrow-Π.comm = pushout-ind _ C
    where
      f : ((x , j , p) : (i ＝ i1 → X) × Scn (i ＝ i1))
        → (i ∧ j , (x ∘ ϕ)) ＝ ((i ∧ j) , X.σ-part (i ∧ j) ((χ *₁ x) p))
      f (x , j , p) = Σ-path→ (refl , f-path i x j p)

      g : ((x , j , p) : ((i ＝ i0) * X) × Lᵒ (i ＝ i1))
        → ((i ∧ j) , X.σ-part i x ∘ ϕ) ＝ (((i ∧ j) , X.σ-part (i ∧ j) ((ψ *₁ id) x)))
      g (x , j , p) = Σ-path→ (refl , funext→ (X.σ-part-nat ϕ ψ x))

      lem
        : (j : Δ¹)
          (x : (i ＝ i0) * X)
          (p : (j ＝ i0) * (i ＝ i1))
        → X.σ-part-nat ϕ ψ x
        ＝ f-htpy i (X.σ-part i x) j p
        ∙h happly (ap (X.σ-part (i ∧ j)) (H-path i x j p))
      lem j = pushout-ind _
        (mk-coconeᵈ
          (λ p _ → funext→ (λ r → is-truncated←is-single
            (X.is-single←i=1←i=0 p (ϕ r)) {n = 0𝕋} _ _ _ _))
          (λ x → pushout-ind _
            (mk-coconeᵈ
              (λ p → funext→ (λ q → is-truncated←is-single
                (X.is-single←i=1←i=0 p (ϕ' q)) {n = 0𝕋} _ _ _ _))
              (λ p → funext→ (λ q → sym (ap (_∙ _) (∙-reflr _ ∙ ap-const _))))
              (λ (p , _) → Π-is-set (λ q → is-truncated←is-single
                (X.is-single←i=1←i=0 p (ϕ' q)) {n = 1𝕋} _ _) _ _ _ _)))
          (λ (p , _) → Π-is-prop
            (λ _ → Π-is-set (λ r → is-truncated←is-single
              (X.is-single←i=1←i=0 p (ϕ r)) {n = 1𝕋} _ _) _ _) _ _))

      lem'
        : (j : Δ¹)
          (x : (i ＝ i0) * X)
          (p : (j ＝ i0) * (i ＝ i1))
        → funext→ (X.σ-part-nat ϕ ψ x)
        ＝ f-path i (X.σ-part i x) j p ∙ ap (X.σ-part (i ∧ j)) (H-path i x j p)
      lem' j x p
        = ap funext→ (lem j x p)
        ∙ funext-∙ _ (happly (ap (X.σ-part (i ∧ j)) (H-path i x j p)))
        ∙ ap ((f-path i (X.σ-part i x) j p) ∙_) (funext.η _)

      C : Coconeᵈ
            (mk-span
              (((i ＝ i0) * X) × Scn (i ＝ i1))
              (X.σ-part i ×₁1 Scn (i ＝ i1))
              (((i ＝ i0) * X) 1×₁ D.σ))
            pushout
            _
      C .Coconeᵈ.p = f
      C .Coconeᵈ.q = g
      C .Coconeᵈ.filler (x , j , p)
        = Idᵈ-func←Square
              {f = (ε i ∘ (pushout-product (X.σ-part i) D.σ))}
              {g = (X.σ ∘ ε̄̃ i)}
              (glue (x , j , p))
              (f (X.σ-part i x , j , p))
              (g (x , j , D.σ-part j p))
              (mk-square
                ( ((ε i ∘ (X.σ-part i □ D.σ)) ◃h glue) (x , j , p)
                ∙ g (x , j , D.σ-part j p)

                ＝⟨ ap
                    (_∙ g (x , j , D.σ-part j p))
                    (cogap-◃h-glue _ (ε i) (x , j , p)) ⟩

                (ε i ◃h Product-hom (X.σ-part i) D.σ .Arrow-Π.comm) (x , j , p)
                ∙ g (x , j , D.σ-part j p)

                ＝⟨ ∙-refll _ ⟩

                g (x , j , D.σ-part j p)

                ＝⟨ Id-IdΣ→ _ _
                      (refl
                      , lem' j x p
                      ∙ ap (_∙ ap (X.σ-part (i ∧ j)) (H-path i x j p)) (sym (ap-id _)))
                  ⟩

                Σ-path→ (＝Σ-∙ (refl , f-path i (X.σ-part i x) j p) (refl , ap (X.σ-part (i ∧ j)) (H-path i x j p)))

                ＝⟨ Σ-path→-∙ (refl , f-path i (X.σ-part i x) j p) (refl , ap (X.σ-part (i ∧ j)) (H-path i x j p)) ⟩

                f (X.σ-part i x , j , p)
                ∙ Σ-path→ (refl , ap (X.σ-part (i ∧ j)) (H-path i x j p))


                ＝⟨ ap (f (X.σ-part i x , j , p) ∙_) (sym (ap-total-map-Σ-path-refl _ _)) ⟩

                f (X.σ-part i x , j , p)
                ∙ ap X.σ (H i (x , j , p))

                ＝⟨⟩

                ap (f (X.σ-part i x , j , p) ∙_) (sym (cogap-◃h-glue _ X.σ (x , j , p)))))

  right-square
    : Arrow-map (total-map (λ i → pushout-product (X.σ-part i) D.σ)) X.σ
  right-square .Arrow-Π.top = uncurry ε̄̃
  right-square .Arrow-Π.bot = uncurry ε
  right-square .Arrow-Π.comm x = (S (x .fst)) .Arrow-Π.comm (x .snd)

  g : (a : Scn X) → Σ[ i ∶ Δ¹ ] (Pushout ((X.σ-part i ×₁1 _)) (_ 1×₁ D.σ))
  g = total-map (λ a x → ι₂ (x , a , id))

  g' : (a : Lᵒ X) → Σ[ i ∶ Δ¹ ] ((i ＝ i1 → X) × Lᵒ (i ＝ i1))
  g' = total-map (λ a x → (x , a , id))

  left-square : Arrow-map X.σ (total-map (λ i → (X.σ-part i) □ D.σ))
  left-square .Arrow-Π.top = g
  left-square .Arrow-Π.bot a = (a .fst , (a .snd) , a .fst , id)
  left-square .Arrow-Π.comm = ~refl

module EasyMode
  (h : i0 ≠ i1)
  (let module M {𝓤} {X : Type 𝓤} = WithCoStrict {X = X} (¡ ∘ h))
  (let module N {𝓤} {X : Type 𝓤} = WithCoStrictMeet {X = X} (¡ ∘ h))
  where
  open M public
  open N public

module _
  {𝓤} {X : Type 𝓤} {h : i0 ≠ i1}
  (open EasyMode h)
  where

  Idᶠ-∘-prop
    : ∀ {𝓤} {i j : Δ¹} {Y : Type 𝓤}
      → (p : j ＝ i)
      → (f : j ＝ i1 → i ＝ i1)
      → (h : i ＝ i1 → Y)
      → Idᶠ _ p (h ∘ f) h
  Idᶠ-∘-prop refl f h = ap (h ∘_) prop!

  Idᶠ-*-prop
    : {i j : Δ¹}
    → (p : j ＝ i)
    → (g : i ＝ i0 → j ＝ i0)
    → (x : (i ＝ i0) * X)
    → Idᶠ _ p (((g *₁ id) x)) x
  Idᶠ-*-prop {i} refl g x = *₁-htpy (λ _ → prop!) ~refl x ∙ (*₁-id h⁻¹) x

  σ-nat-id
    : {i : Δ¹}
    → (x : (i ＝ i0) * X)
    → σ-part-nat id id x ＝ happly (((σ-part i) ◃h (*₁-id)) x)
  σ-nat-id {i}
    = pushout-ind
        (eq-value (σ-part-nat id id) (happly ∘ (σ-part i ◃h *₁-id)))
        (mk-coconeᵈ (λ p → funext→ (λ q → ¡ (h (sym p ∙ q))))
        ~refl
        (λ (p , x) → unap-equiv global-funext (funext→ (λ q → ¡ (h (sym p ∙ q))))))

  lem2-id
    : {i : Δ¹}
    → (x : (i ＝ i0) * X)
    → ((funext→ ∘ σ-part-nat id id) ∙h (σ-part i ◃h (*₁-htpy (λ _ → prop!) ~refl ∙h (*₁-id h⁻¹)))) x
    ＝ ap ((σ-part i x) ∘_) prop!
  lem2-id {i} x =
    ((funext→ ∘ σ-part-nat id id) ∙h
       σ-part i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x
         ＝⟨ ap
              (_∙ (σ-part i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x) (ap funext→ (σ-nat-id x)) ⟩
    ((funext→ ∘ happly ∘ ((σ-part i) ◃h (*₁-id))) ∙h
       σ-part i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x
       ＝⟨ ap
            (_∙ (σ-part i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x) (_≃_.η funext≃ (((σ-part i) ◃h (*₁-id)) x)) ⟩
    ((σ-part i ◃h (*₁-id)) ∙h(σ-part i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹))) x
      ＝⟨ (◃h∙ (σ-part i) _ _ h⁻¹) x ⟩
       (σ-part i ◃h (*₁-id ∙h (*₁-htpy (λ z → prop!) ~refl) ∙h *₁-id h⁻¹)) x
      ＝⟨ ap (λ - → (σ-part i ◃h (*₁-id ∙h (*₁-htpy - ~refl) ∙h *₁-id h⁻¹)) x) prop! ⟩
       (σ-part i ◃h (*₁-id ∙h (*₁-htpy ~refl ~refl) ∙h *₁-id h⁻¹)) x
      ＝⟨ ap (λ - → (σ-part i ◃h (*₁-id ∙h - ∙h *₁-id h⁻¹)) x) (funext→ *₁-htpy-refl) ⟩
       (σ-part i ◃h (*₁-id ∙h *₁-id h⁻¹)) x
      ＝⟨ ap (ap (σ-part i)) (∙-sym (*₁-id x)) ⟩
        refl
      ＝⟨ sym (ap-refl' prop! _) ⟩
        ap (_∘_ (σ-part i x)) prop! ∎

  lem2
    : {i : Δ¹}
    → (f : i ＝ i1 → i ＝ i1)
    → (g : i ＝ i0 → i ＝ i0)
    → (x : (i ＝ i0) * X)
    → ((funext→ ∘ σ-part-nat f g) ∙h (σ-part i ◃h (*₁-htpy (λ _ → prop!) ~refl ∙h (*₁-id h⁻¹)))) x
    ＝ (ap ((σ-part i x) ∘_) prop!)
  lem2 {i} f g x
    = tr₂
        (λ f g₁
        → ((funext→ ∘ σ-part-nat f g₁)
        ∙h σ-part i ◃h (*₁-htpy (λ _ → prop!) ~refl ∙h *₁-id h⁻¹))
          x
        ＝ ap (σ-part i x ∘_) prop!)
        prop! prop! (lem2-id x)

  Path-Idᶠ-σ-nat
    : {i j : Δ¹}
    → (p : j ＝ i)
    → (f : j ＝ i1 → i ＝ i1)
    → (g : i ＝ i0 → j ＝ i0)
    → (x : (i ＝ i0) * X)
    → transIdᶠ
        refl
        p
        (funext→ (σ-part-nat f g x))
        (happlyᶠ p (σ-part j) (σ-part i) (apᶠ σ-part p) (Idᶠ-*-prop p g x))
    ＝ Idᶠ-∘-prop p f (σ-part i x)
  Path-Idᶠ-σ-nat {i} {j} refl f g x =
    ap (_∙ _) (ap-id (funext→ (σ-part-nat f g x))) ∙ lem2 f g x

  top : uncurry ε̄̃ ∘ g ~ id
  top = Σ-path→ ∘ uncurry (λ i x → (∧-idem , Idᶠ-*-prop ∧-idem ψ x))

  bot : (x : Lᵒ X) → ε (x .fst) (g' x .snd) ＝ x
  bot = Σ-path→ ∘ uncurry (λ i x → (∧-idem , Idᶠ-∘-prop ∧-idem ϕ x))

  Sierpinski-retract-coh
    : Arrow-map-path
        (paste-squares (right-square {X = X}) left-square)
        (id-square)
  Sierpinski-retract-coh .fst = top
  Sierpinski-retract-coh .snd .fst = bot
  Sierpinski-retract-coh .snd .snd
    = (K ▹h g) ∙h (σ ◃h top)
        ~⟨ (~refl: K ∘ g) ⟩∙h⟨ uncurry (λ i x → Σ-path→-ap-total-map σ-part (∧-idem , _)) ⟩
     (K ▹h g)
     ∙h (λ a
        → Σ-path→
            (＝Σ-ap-total-map σ-part (∧-idem , Idᶠ-*-prop ∧-idem ψ (a .snd))))
        ~⟨
       (λ where
         (i , x) → sym (Σ-path→-∙ _ _)
                 ∙ (Id-IdΣ→ (＝Σ-∙ (refl , _) _) _ (refl , Path-Idᶠ-σ-nat ∧-idem ϕ ψ x))) ⟩
     bot ∘ σ
        ~⟨ ~sym (∙h-reflr _) ⟩
     (bot ∘ σ) ∙h ~refl ~∎
    where
      K = right-square .Arrow-Π.comm
}
