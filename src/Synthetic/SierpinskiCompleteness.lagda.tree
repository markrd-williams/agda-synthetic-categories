\date{2026-10-13}
\title{Sierpiński Completeness}
\taxon{Module}
\author{markwilliams}
\import{stt-macros}

\p{
Based on work in progress by [Bakke](fredrikbakke), [Sterling](jonsterling),
[Damuni Williams](markwilliams) and [Ye](lingyuanye),
revising a proof in the unpublished manuscript
[The Synthetic Sierpiński Cone](https://arxiv.org/abs/2605.00773).
}

\agda{
{-# OPTIONS --lossy-unification #-}

open import Foundations.Universes
open import Algebra.Lattice

module Synthetic.SierpinskiCompleteness {𝓘} (Δ¹ : Type 𝓘) (I : Lattice Δ¹)  where

open Lattice I renaming (0l to i0; 1l to i1)

open import Axioms.UF
}

\agda-imports{
\agda{
open import Foundations.Prelude

open import Core.Arrows
open import Core.ArrowEquiv
open import Core.CanonicalPushouts

open import Ergonomics.Representation
open import Ergonomics.Extensionality
open import Ergonomics.Universal

open import Core.PushoutSums
open import Core.SigmaDependentIdentity
open import Core.SigmaIdentityProperties
open import Core.Joins
}
}

\agda{
Lᵒ : ∀ {𝓤} (X : Type 𝓤) → Type (𝓘 ⊔ 𝓤)
Lᵒ X = Σ[ i ∶ Δ¹ ] ((i ＝ i1) → X)

Lᵒ₁ : ∀ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} (f : X → Y)
    → Lᵒ X → Lᵒ Y
Lᵒ₁ f (i , p) = i , (f ∘ p)

Scn : ∀ {𝓤} (X : Type 𝓤) → Type (𝓘 ⊔ 𝓤)
Scn X = Σ[ i ∶ Δ¹ ] ((i ＝ i0) * X)

Scn₁ : ∀ {𝓤 𝓥} {X : Type 𝓤} {Y : Type 𝓥} (f : X → Y)
        → Scn X → Scn Y
Scn₁ f (i , x) = i , (id *₁ f) x

module EasyMode (h : ¬ (i0 ＝ i1)) where

  σ-part-Cocone
    : ∀ {𝓤} (X : Type 𝓤) (i : Δ¹)
      → Cocone (mk-span ((i ＝ i0) × X) (λ r → fst r) (λ r → snd r)) (i ＝ i1 → X)
  σ-part-Cocone X i .Cocone.p p q = ¡ (h (sym p ∙ q))
  σ-part-Cocone X i .Cocone.q x _ = x
  σ-part-Cocone X i .Cocone.filler (p , _) = funext→ λ q → ¡ (h (sym p ∙ q))

  σ-part : ∀ {𝓤} (X : Type 𝓤) (i : Δ¹) → (i ＝ i0) * X → (i ＝ i1) → X
  σ-part X i = pushout-rec (σ-part-Cocone X i)

  τ-part : ∀ {𝓤} (X : Type 𝓤) (i : Δ¹) → X * (i ＝ i1) → (i ＝ i0) → X
  τ-part X i = pushout-rec C
    where
      C : Cocone _ _
      C .Cocone.p x _ = x
      C .Cocone.q p q = ¡ (h (sym q ∙ p))
      C .Cocone.filler (x , p) = funext→ λ q → ¡ (h (sym q ∙ p))

  σ : ∀ {𝓤} (X : Type 𝓤) → Scn X → Lᵒ X
  σ = total-map ∘ σ-part

  Sierpinski-interchange
    : ∀ {𝓤 𝓥} (X : Type 𝓤) (Y : Type 𝓥)
      → (i : Δ¹)
      → (x : (i ＝ i0) * X) (y : Y * (i ＝ i1))
      → (id *₁ (σ-part X i x)) y ＝ (τ-part Y i y *₁ id) x
  Sierpinski-interchange X Y i
    = pushout-ind _
        (mk-coconeᵈ
          (λ p → pushout-ind _
            (mk-coconeᵈ
              (~refl)
              (λ q → ¡ (h (sym p ∙ q) ))
              λ { (y , q) → ¡ (h (sym p ∙ q)) }))
          (λ x → pushout-ind _
            (mk-coconeᵈ
              (λ y → glue (y , x))
              (~refl)
              λ a → Idᵈ-func←Square _ _ _
                (Square-paste-horizontal
                  (Square-degen-hor _ _ (pushout-rec-apβ _))
                  (mk-square (ap (_ ∙_) (sym (ap-const _)))))))
          λ {(p , x) → funext→ (pushout-ind _
            (mk-coconeᵈ
              ({! (λ z → (y : Y * (i ＝ i1)) → (id *₁ σ-part X i z) y ＝ (τ-part Y i y *₁ id) z) ◃h glue !} )
              (λ q → ¡ (h (sym p ∙ q)))
              λ {(y , q) → ¡ (h (sym p ∙ q)) })) })

module _ {𝓤} {X : Type 𝓤} {h : ¬ (i0 ＝ i1)} (open EasyMode h) where

  opaque
    χ : {i j : Δ¹} → j ＝ i0 → i ∧ j ＝ i0
    χ = ＝0←≤0 ∘ ∧-≤-elimr ∘ ≤←＝

    ψ : {i j : Δ¹} → i ＝ i0 → i ∧ j ＝ i0
    ψ = ＝0←≤0 ∘ ∧-≤-eliml ∘ ≤←＝

    ϕ' : {i j : Δ¹} → i ∧ j ＝ i1 → j ＝ i1
    ϕ' p = ＝1←1≤ (≤-trans (≥←＝ p) (∧-≤-elimr ≤-refl))

    ϕ : {i j : Δ¹} → i ∧ j ＝ i1 → i ＝ i1
    ϕ p = ＝1←1≤ (≤-trans (≥←＝ p) (∧-≤-eliml ≤-refl))

  ε̄ : (i : Δ¹) →  ((i ＝ i1) → X) × ( Scn (i ＝ i1 )  ) → Scn X
  ε̄  i (x , j , p) .fst = i ∧ j
  ε̄ i (x , j , p) .snd = (χ *₁ x) p

  ε̃ : (i : Δ¹) → ((i ＝ i0) * X) × ( Lᵒ ( i ＝ i1 )) → Scn X
  ε̃  i (x , j , p) .fst = i ∧ j
  ε̃ i (x , j , p) .snd =  (ψ *₁ id) x

  H-path
    : (i : Δ¹) (x : (i ＝ i0) * X) (j : Δ¹) (p : (j ＝ i0) * (i ＝ i1))
    → (χ *₁ σ-part X i x) p ＝ (ψ *₁ id) x
  H-path i x j p
    = (χ *₁ σ-part X i x) p
        ＝⟨ sym (*₁-∘ _ _ _ _ p) ⟩
      ((χ *₁ id) ∘ (id *₁ σ-part X i x)) p
        ＝⟨ ap (χ *₁ id) (Sierpinski-interchange X (j ＝ i0) i x p) ⟩
      ((χ *₁ id) ∘ (τ-part (j ＝ i0) i p) *₁ id) x
        ＝⟨ *₁-∘ _ _ _ _ x ⟩
      ((χ ∘ (τ-part (j ＝ i0) i p)) *₁ id) x
        ＝⟨⟩
      *₁-htpy (λ _ → prop!) ~refl x

  H : (i : Δ¹)
      → ε̄ i ∘ (σ-part X i ×₁ id) ~ ε̃ i ∘ id ×₁ σ (i ＝ i1)
  H i (x , (j , p)) =
    Σ-path→ (refl , H-path i x j p)

  ε̄̃-Cocone
    : (i : Δ¹)
    → Cocone (mk-span _ (σ-part X i ×₁ id) (id ×₁ σ (i ＝ i1))) (Scn X)
  ε̄̃-Cocone i .Cocone.p = ε̄ i
  ε̄̃-Cocone i .Cocone.q = ε̃ i
  ε̄̃-Cocone i .Cocone.filler = H i

  ε̄̃ : (i : Δ¹)
    → Pushout (σ-part X i ×₁ id) (id ×₁ σ (i ＝ i1))
    → Scn X
  ε̄̃ i = pushout-rec (ε̄̃-Cocone i)

  σ-part-nat'
    : ∀ {𝓤 𝓥} {j : Δ¹} {A : Type 𝓤} {B : Type 𝓥}
      → (f : A → B)
      → (a : (j ＝ i0) * A)
      →  f ∘ σ-part A j a ~ σ-part B j ( (id *₁ f) a)
  σ-part-nat' f =
    pushout-ind _
      (mk-coconeᵈ
        (λ p q → ¡ (h (sym p ∙ q)))
        (λ p → ~refl)
        λ a → funext→ λ q → ¡ (h (sym (fst a) ∙ q)))

  σ-part-nat
    : ∀ {𝓤} {i j : Δ¹} {A : Type 𝓤}
      → (f : (j ＝ i1) → (i ＝ i1))
      → (g : (i ＝ i0) → (j ＝ i0))
      → (a : (i ＝ i0) * A)
      → (p : j ＝ i1)
      → ((_∘ f) ∘ (σ-part A i)) a p  ＝ (σ-part A j ∘ (g *₁ id)) a p
  σ-part-nat {i = i} {j} {A} f g a q =
    pushout-ind (λ z → ((_∘ f) ∘ σ-part A i) z q ＝ (σ-part A j ∘ (g *₁ id)) z q)
      (mk-coconeᵈ
        (λ p → ¡ (h (sym p ∙ f q )))
        (~refl)
        λ { (p , x) → ¡ (h (sym p ∙ f q)) }) a

  ε : (i : Δ¹) → ((i ＝ i1 → X) × Lᵒ (i ＝ i1)) → Lᵒ X
  ε i (x , j , p) .fst = i ∧ j
  ε i (x , j , p) .snd = x ∘ ϕ

  f-path
    : ∀ i (x : i ＝ i1 → X) (j : Δ¹) (p : (j ＝ i0) * (i ＝ i1))
      → x ∘ ϕ ＝ σ-part X (i ∧ j) ((χ *₁ x) p)
  f-path i x j p
    = funext→
    ( x ∘ ϕ
        ~⟨  x ◃h (λ a → prop!) ⟩
      x ∘ σ-part (i ＝ i1) (i ∧ j) ((χ *₁ id) p)
        ~⟨ σ-part-nat' x ((χ *₁ id) p) ⟩
      (σ-part X (i ∧ j) ∘ (id *₁ x) ∘ (χ *₁ id)) p
        ~⟨⟩
      happly ((σ-part X (i ∧ j) ◃h (*₁-∘ id x χ id)) p))
--         (σ-part X (i ∧ j) ∘ (χ *₁ x)) p ~∎

  S : (i : Δ¹) → Arrow-map (pushout-product (σ-part X i) (σ (i ＝ i1)))  (σ X)
  S i .Arrow-Π.top = ε̄̃ i
  S i .Arrow-Π.bot  = ε i
  S i .Arrow-Π.comm = pushout-ind _ C
    where
      f : ((x , j , p) : (i ＝ i1 → X) × Scn (i ＝ i1))
        → (i ∧ j , (x ∘ ϕ)) ＝ ((i ∧ j) , σ-part X (i ∧ j) ((χ *₁ x) p))
      f (x , j , p) =
        Σ-path→ (refl , f-path i x j p)

      g : ((x , j , p) : ((i ＝ i0) * X) × Lᵒ (i ＝ i1))
        → ((i ∧ j) , σ-part X i x ∘ ϕ) ＝ (((i ∧ j) , σ-part X (i ∧ j) ((ψ *₁ id) x)))
      g (x , j , p) = Σ-path→ (refl , funext→ (σ-part-nat ϕ ψ x))

      lem
        : (j : Δ¹)
          (x : (i ＝ i0) * X)
          (p : (j ＝ i0) * (i ＝ i1))
        → σ-part-nat ϕ ψ x
        ＝ ( λ a
          → (ap (σ-part X i x) prop!)
          ∙ (σ-part-nat' (σ-part X i x) ((χ *₁ id) p) a)
          ∙ (happly (ap (σ-part X (i ∧ j)) (*₁-∘ _ _ _ _ p)) a))
        ∙h happly (ap (σ-part X (i ∧ j)) (H-path i x j p))
      lem j = pushout-ind _
        (mk-coconeᵈ
          (λ p → pushout-ind _
            (mk-coconeᵈ
              (λ q → funext→ λ r → ¡ (h (sym p ∙ ϕ r)))
              (λ r → ¡ (h (sym p ∙ r)))
              λ { (_ , s) → ¡ (h (sym p ∙ s) ) }))
         (λ x → pushout-ind _
           (mk-coconeᵈ
             (λ p → funext→ λ q → ¡ (h (sym p ∙ ϕ' q)))
             (λ p → funext→ λ q →  sym (ap (_∙ _) (∙-reflr _ ∙ ap-const _)))
             λ {(p , _) → unap-equiv global-funext
               (funext→ (λ q → ¡ (h (sym p ∙ ϕ' q))))}))
         λ { (p , x) → funext→ (pushout-ind _
           (mk-coconeᵈ
             (λ q → unap-equiv global-funext (funext→ λ r → ¡ (h (sym p ∙ ϕ r))))
             (λ r → ¡ (h (sym p ∙ r)))
             λ (_ , r) → ¡ (h (sym p ∙ r)))) })

      lem'
        : (j : Δ¹)
          (x : (i ＝ i0) * X)
          (p : (j ＝ i0) * (i ＝ i1))
        → funext→ (σ-part-nat ϕ ψ x)
        ＝ f-path i (σ-part X i x) j p ∙ ap (σ-part X (i ∧ j)) (H-path i x j p)
      lem' j x p
        = ap funext→ (lem j x p)
        ∙ funext-∙ _ (happly (ap (σ-part X (i ∧ j)) (H-path i x j p)))
        ∙ ap ((f-path i (σ-part X i x) j p) ∙_) (funext.η _)

      C : Coconeᵈ _ _ _
      C .Coconeᵈ.p  = f
      C .Coconeᵈ.q  = g
      C .Coconeᵈ.filler
        = λ {(x , j , p)
          → Idᵈ-func←Square
              {f = ((ε i) ∘ (pushout-product (σ-part X i) (σ (i ＝ i1))))}
              {g = (σ X ∘ ε̄̃ i)}
              (glue (x , j , p))
              (f (σ-part X i x , j , p))
              (g (x , j , σ-part (i ＝ i1) j p))
              (mk-square
                ( ( (ε i ∘ (σ-part X i □ σ (i ＝ i1))) ◃h glue ) (x , j , p)
                ∙ g (x , j , σ-part (i ＝ i1) j p)

                ＝⟨ ap (_∙ g (x , j , σ-part (i ＝ i1) j p)) (cogap-◃h-glue _ (ε i) (x , j , p)) ⟩

                (ε i ◃h Product-hom (σ-part X i) (σ (i ＝ i1)) .Arrow-Π.comm) (x , j , p)
                ∙ g (x , j , σ-part (i ＝ i1) j p)

                ＝⟨ ∙-refll _ ⟩

                g (x , j , σ-part (i ＝ i1) j p)

                ＝⟨  Id-IdΣ→ _ _
                      (refl
                      , lem' j x p
                      ∙ ap (_∙ ap (σ-part X (i ∧ j)) (H-path i x j p)) (sym (ap-id _)))
                  ⟩

                Σ-path→ (＝Σ-∙ (refl , f-path i (σ-part X i x) j p)  (refl ,  ap (σ-part X (i ∧ j)) (H-path i x j p)))

                ＝⟨  Σ-path→-∙ (refl , f-path i (σ-part X i x) j p) (refl ,  ap (σ-part X (i ∧ j)) (H-path i x j p)) ⟩

                f (σ-part X i x , j , p)
                ∙ Σ-path→ (refl ,  ap (σ-part X (i ∧ j)) (H-path i x j p))


                ＝⟨  ap (f (σ-part X i x , j , p) ∙_) ( sym (ap-total-map-Σ-path-refl _ _) ) ⟩

                f (σ-part X i x , j , p)
                ∙ ap (σ X) (H i (x , j , p))

                ＝⟨⟩

                ap (f (σ-part X i x , j , p) ∙_) (sym (cogap-◃h-glue _ (σ X) (x , j , p)))))}

  right-square
    : Arrow-map (total-map (λ i → pushout-product (σ-part X i) (σ (i ＝ i1)))) (σ X)
  right-square .Arrow-Π.top = uncurry ε̄̃
  right-square .Arrow-Π.bot = uncurry ε
  right-square .Arrow-Π.comm x = (S (x .fst)) .Arrow-Π.comm (x .snd)

  g : (a : Scn X) → Σ[ i ∶ Δ¹ ] (Pushout ((σ-part X i ×₁1 _)) (_ 1×₁ (σ (i ＝ i1))))
  g = total-map (λ a x → ι₂ (x , a , id))

  g' : (a : Lᵒ X) → Σ[ i ∶ Δ¹ ] ((i ＝ i1 → X) × Lᵒ (i ＝ i1))
  g' = total-map (λ a x → x , a , id)

  left-square : Arrow-map (σ X) (total-map (λ i → (σ-part X i) □ (σ (i ＝ i1))))
  left-square .Arrow-Π.top = g
  left-square .Arrow-Π.bot = λ a →  a .fst , (a .snd) , a .fst , id
  left-square .Arrow-Π.comm = ~refl

  Idᶠ-∘-prop
    : ∀ {𝓤} {i j : Δ¹} {Y : Type 𝓤}
      → (p : j ＝ i)
      → (f : j ＝ i1 → i ＝ i1)
      → (h : i ＝ i1 → Y)
      → Idᶠ _ p (h ∘ f) h
  Idᶠ-∘-prop refl f h = ap (h ∘_) prop!

  Idᶠ-*-prop
    : {i j : Δ¹}
    → (p : j ＝ i)
    → (g : i ＝ i0 → j ＝ i0)
    → (x : (i ＝ i0) * X)
    → Idᶠ _ p (((g *₁ id) x)) x
  Idᶠ-*-prop {i} refl g x = *₁-htpy (λ _ → prop!) ~refl x ∙  (*₁-id h⁻¹) x

  σ-nat-id
    : {i : Δ¹}
    → (x : (i ＝ i0) * X)
    → σ-part-nat id id x ＝ happly (((σ-part X i) ◃h (*₁-id)) x)
  σ-nat-id {i}  =
    pushout-ind _
      (mk-coconeᵈ (λ p → funext→ (λ q → ¡ (h (sym p ∙ q))))
      ~refl
      λ (p , x) → unap-equiv global-funext (funext→ (λ q → ¡ (h (sym p ∙ q)))))

  lem2-id
    : {i : Δ¹}
    → (x : (i ＝ i0) * X)
    → ((funext→ ∘ σ-part-nat id id) ∙h (σ-part X i ◃h (*₁-htpy (λ _ → prop!) ~refl ∙h  (*₁-id h⁻¹)))) x
    ＝ ap ((σ-part X i x) ∘_) prop!
  lem2-id {i} x =
    ((funext→ ∘ σ-part-nat id id) ∙h
       σ-part X i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹))  x
         ＝⟨ ap
              (_∙ (σ-part X i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x) (ap funext→ (σ-nat-id x)) ⟩
    ((funext→ ∘ happly ∘ ((σ-part X i) ◃h (*₁-id))) ∙h
       σ-part X i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x
       ＝⟨ ap
            (_∙ (σ-part X i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹)) x) (_≃_.η funext≃ (((σ-part X i) ◃h (*₁-id)) x) ) ⟩
    ((σ-part X i ◃h (*₁-id)) ∙h(σ-part X i ◃h (*₁-htpy (λ z → prop!) ~refl ∙h *₁-id h⁻¹))) x
      ＝⟨ (◃h∙ (σ-part X i) _ _ h⁻¹) x ⟩
       (σ-part X i ◃h ( *₁-id ∙h (*₁-htpy (λ z → prop!) ~refl) ∙h *₁-id h⁻¹)) x
      ＝⟨ ap (λ - → (σ-part X i ◃h ( *₁-id ∙h (*₁-htpy - ~refl) ∙h *₁-id h⁻¹)) x) prop! ⟩
       (σ-part X i ◃h ( *₁-id ∙h (*₁-htpy ~refl ~refl) ∙h *₁-id h⁻¹)) x
      ＝⟨ ap (λ - → (σ-part X i ◃h ( *₁-id ∙h - ∙h *₁-id h⁻¹)) x) (funext→ *₁-htpy-refl) ⟩
       (σ-part X i ◃h ( *₁-id ∙h *₁-id h⁻¹)) x
      ＝⟨  ap (ap (σ-part X i)) (∙-sym (*₁-id x)) ⟩
        refl
      ＝⟨ sym (ap-refl' prop! _) ⟩
        ap (_∘_ (σ-part X i x)) prop! ∎

  lem2
    : {i : Δ¹}
    → (f : i ＝ i1 → i ＝ i1)
    → (g : i ＝ i0 → i ＝ i0)
    → (x : (i ＝ i0) * X)
    → ((funext→ ∘ σ-part-nat f g) ∙h (σ-part X i ◃h (*₁-htpy (λ _ → prop!) ~refl ∙h  (*₁-id h⁻¹)))) x
               ＝ (ap ((σ-part X i x) ∘_) prop!)
  lem2 {i} f g x
    = tr₂
        (λ f g₁ →
            ((funext→ ∘ σ-part-nat f g₁) ∙h
            σ-part X i ◃h (*₁-htpy (λ _ → prop!) ~refl ∙h *₁-id h⁻¹))
            x
            ＝ ap (σ-part X i x ∘_) prop!)
        prop! prop! (lem2-id x)

  Path-Idᶠ-σ-nat
    : {i j : Δ¹}
    → (p : j ＝ i)
    → (f : j ＝ i1 → i ＝ i1)
    → (g : i ＝ i0 → j ＝ i0)
    → (x : (i ＝ i0) * X)
    → transIdᶠ
        refl
        p
        (funext→ (σ-part-nat f g x))
        (happlyᶠ p (σ-part X j) (σ-part X i) (apᶠ (σ-part X) p) (Idᶠ-*-prop p g x))
    ＝ Idᶠ-∘-prop p f (σ-part X i x)
  Path-Idᶠ-σ-nat {i} {j} refl f g x =
    ap (_∙ _) ( ap-id (funext→ (σ-part-nat f g x)))
    ∙ ( (funext→ (σ-part-nat f g x))
      ∙ (ap (σ-part X i) (*₁-htpy (λ _ → prop!) ~refl x ∙  (*₁-id h⁻¹) x))
      ＝⟨ lem2 f g x ⟩
      ap ((σ-part X i x) ∘_) prop!  ∎ )

  top : uncurry ε̄̃  ∘ g ~ id
  top = Σ-path→ ∘ uncurry (λ i x → ∧-idem ,  Idᶠ-*-prop ∧-idem ψ x)

  bot : (x : Lᵒ X) → ε (x .fst) (g' x .snd) ＝ x
  bot = Σ-path→ ∘ uncurry λ i x → ∧-idem , (Idᶠ-∘-prop ∧-idem (λ z → ϕ z) x)

  sierpinski-retract : Arrow-map-path (paste-squares right-square left-square) id-square
  sierpinski-retract .fst = top
  sierpinski-retract .snd .fst = bot
  sierpinski-retract .snd .snd
    = (K ▹h g) ∙h (σ X ◃h  top)
        ~⟨ (~refl: K ∘ g) ⟩∙h⟨ uncurry (λ i x → Σ-path→-ap-total-map (σ-part X) (∧-idem , _)) ⟩
     (K ▹h g)
     ∙h (λ a
        → Σ-path→
            (＝Σ-ap-total-map (σ-part X) (∧-idem , Idᶠ-*-prop ∧-idem ψ (a .snd))))
        ~⟨
       (λ where
         (i , x) → sym (Σ-path→-∙ _ _)
                 ∙ (Id-IdΣ→ (＝Σ-∙ (refl , _) _) _ (refl , Path-Idᶠ-σ-nat ∧-idem ϕ ψ x)
                            ))
        ⟩
     bot ∘ σ X
        ~⟨  ~sym (∙h-reflr _) ⟩
     (bot ∘ (σ X)) ∙h ~refl ~∎
    where
      K = right-square .Arrow-Π.comm
}
